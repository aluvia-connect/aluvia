{
  "name": "aluvia-cli",
  "version": "1.4.9",
  "description": "Local CLI that sends a cloud agent's Chrome through global residential and mobile IPs. npx aluvia-cli setup",
  "license": "MIT",
  "author": "Aluvia",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aluvia-connect/aluvia.git"
  },
  "homepage": "https://aluvia.io",
  "bugs": {
    "url": "https://github.com/aluvia-connect/aluvia/issues"
  },
  "type": "module",
  "main": "./dist/esm/cli.js",
  "types": "./dist/types/cli.d.ts",
  "bin": {
    "aluvia": "./dist/esm/cli.js"
  },
  "files": [
    "dist/**/*",
    "skills/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.esm.json",
    "sync-skill": "node ./scripts/sync-skill.mjs",
    "prepack": "node ./scripts/prepack.mjs",
    "test": "node --import tsx --test test/*.test.ts",
    "lint": "prettier --check src test",
    "lint:fix": "prettier --write src test"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "cli",
    "proxy",
    "aluvia",
    "geo",
    "residential",
    "grok-bot",
    "playwright",
    "cloudflare",
    "captcha",
    "datacenter"
  ],
  "devDependencies": {
    "@types/node": "^24.10.2",
    "prettier": "^3.4.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "proxy-chain": "^2.6.1"
  }
}
