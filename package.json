{
  "name": "aluvia-monorepo",
  "version": "1.4.1",
  "private": true,
  "description": "Aluvia CLI — local proxy for computer-use agents",
  "license": "MIT",
  "author": "Aluvia",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aluvia-connect/sdk-node.git"
  },
  "homepage": "https://aluvia.io",
  "bugs": {
    "url": "https://github.com/aluvia-connect/sdk-node/issues"
  },
  "type": "module",
  "workspaces": [
    "packages/cli"
  ],
  "scripts": {
    "publish:dry-run": "npm publish --dry-run -w aluvia-cli --access public",
    "publish:cli": "npm publish -w aluvia-cli --access public",
    "build": "npm run build -w aluvia-cli",
    "build:cli": "npm run build -w aluvia-cli",
    "test": "npm test -w aluvia-cli",
    "test:cli": "npm test -w aluvia-cli",
    "lint": "npm run lint -w aluvia-cli",
    "lint:fix": "npm run lint:fix -w aluvia-cli"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "cli",
    "proxy",
    "aluvia"
  ]
}
